{
  "info": {
    "name": "Approve Endpoints Testing",
    "description": "Test collection for expense and task approval endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as PM",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"pm_token\", jsonData.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pm@cema.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login as Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"staff_token\", jsonData.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@cema.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Expense Approval",
      "item": [
        {
          "name": "Create Expense (Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expense created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"expense_id\", jsonData.data.id);",
                  "    console.log(\"Created expense:\", jsonData.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"PROJ-1736421234567\",\n  \"title\": \"Test Construction Materials\",\n  \"amount\": 5000000,\n  \"currency\": \"IDR\",\n  \"category\": \"MATERIALS\",\n  \"date\": \"2026-01-10T00:00:00.000Z\",\n  \"receipt_url\": \"https://example.com/receipt.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"]
            }
          }
        },
        {
          "name": "Approve Expense (PM)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expense_id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expense_id}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Expense (PM)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejection_note\": \"Receipt is not clear. Please upload a better quality image.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expense_id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "{{expense_id}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Task Approval",
      "item": [
        {
          "name": "Create Task (PM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Task created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"task_id\", jsonData.data.id);",
                  "    console.log(\"Created task:\", jsonData.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"PROJ-1736421234567\",\n  \"title\": \"Install electrical wiring\",\n  \"description\": \"Complete electrical installation\",\n  \"budget_allocation\": 3000000,\n  \"due_date\": \"2026-02-15T00:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            }
          }
        },
        {
          "name": "Mark Task as DONE",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{task_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Approve Task (PM)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_approved\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{task_id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{task_id}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Task (PM)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_approved\": false,\n  \"rejection_note\": \"Work quality does not meet standards. Please redo.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{task_id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{task_id}}", "approve"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    }
  ]
}
